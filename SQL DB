-- ==========================================
-- JOIN: FARMERS WITH THEIR MANDI CENTRES
-- ==========================================

SELECT
    f.farmer_code,
    f.farmer_name,
    f.crop_name,
    f.quantity_tonnes,
    f.token_number,
    f.status AS farmer_status,
    m.centre_name,
    m.district
FROM farmers f
JOIN mandi_centres m
    ON f.mandi_code = m.centre_code;

