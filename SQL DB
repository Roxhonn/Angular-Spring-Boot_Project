SELECT
    m.id AS mandi_id,
    m.name AS mandi_name,
    b.slot_date,
    b.status,
    COUNT(b.id) AS total_bookings
FROM mandis m
LEFT JOIN bookings b ON b.mandi_id = m.id
WHERE m.id = 4
GROUP BY m.id, m.name, b.slot_date, b.status;

SELECT
    CURDATE() AS today,
    m.id,
    m.name,
    m.daily_capacity,
    COUNT(b.id) AS booked_today
FROM mandis m
LEFT JOIN bookings b
    ON b.mandi_id = m.id
    AND b.slot_date = CURDATE()
    AND b.status != 'CANCELLED'
WHERE m.id = 4
GROUP BY m.id, m.name, m.daily_capacity;
