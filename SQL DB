
-- ==========================================
-- MANDI CONNECT DATABASE
-- ==========================================

CREATE DATABASE IF NOT EXISTS mandi_connect;

USE mandi_connect;

-- ==========================================
-- TABLE 1: MANDI CENTRES
-- ==========================================

CREATE TABLE IF NOT EXISTS mandi_centres (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    centre_code VARCHAR(20) NOT NULL UNIQUE,
    centre_name VARCHAR(100) NOT NULL, 
    district VARCHAR(100) NOT NULL,
    current_queue INT NOT NULL DEFAULT 0,
    daily_capacity INT NOT NULL,
    status VARCHAR(30) NOT NULL
);

-- ==========================================
-- TABLE 2: FARMERS
-- ==========================================

CREATE TABLE IF NOT EXISTS farmers (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    farmer_code VARCHAR(30) NOT NULL UNIQUE,
    farmer_name VARCHAR(100) NOT NULL,
    crop_name VARCHAR(50) NOT NULL,
    quantity_tonnes DECIMAL(10,2) NOT NULL,
    mandi_code VARCHAR(20) NOT NULL,
    token_number VARCHAR(30),
    status VARCHAR(30) NOT NULL,
    CONSTRAINT fk_farmer_mandi
        FOREIGN KEY (mandi_code)
        REFERENCES mandi_centres(centre_code)
);

-- ==========================================
-- TABLE 3: CROP PRICE FORECASTS
-- ==========================================

CREATE TABLE IF NOT EXISTS crop_price_forecasts (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    crop_name VARCHAR(50) NOT NULL,
    mandi_name VARCHAR(100) NOT NULL,
    current_price DECIMAL(10,2) NOT NULL,
    predicted_price DECIMAL(10,2) NOT NULL,
    change_percent DECIMAL(6,2) NOT NULL,
    trend VARCHAR(30) NOT NULL
);

